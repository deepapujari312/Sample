pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/username/my-web-app.git'
            }
        }


        stage('Deploy to Nginx') {
            steps {
                sh '''
                echo "Deploying website..."

                sudo rm -rf /var/www/html/*

                sudo cp -r * /var/www/html/

                sudo systemctl restart nginx

                echo "Deployment completed"
                '''
            }
        }
    }
}
